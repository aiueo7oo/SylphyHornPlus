<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<AssemblyName>sylphyhorn-cli</AssemblyName>
		<Company>hwtnb.net</Company>
		<Product>SylphyHornPlus</Product>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<Platforms>AnyCPU;x64;x86</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.WindowsDesktop.App" />
		<ProjectReference Include="..\SylphyHorn.Core\SylphyHorn.Core.csproj" />
	</ItemGroup>

	<!-- The CLI reports the app's product version, so read it from SylphyHorn.csproj rather than duplicating it. -->
	<Target Name="ReadProductVersion" BeforeTargets="GetAssemblyVersion">
		<XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\SylphyHorn\SylphyHorn.csproj" Query="/Project/PropertyGroup/Version/text()">
			<Output TaskParameter="Result" PropertyName="Version" />
		</XmlPeek>
		<XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\SylphyHorn\SylphyHorn.csproj" Query="/Project/ItemGroup/AssemblyMetadata[@Include='ExtraVersion']/@Value">
			<Output TaskParameter="Result" PropertyName="ProductExtraVersion" />
		</XmlPeek>
		<ItemGroup>
			<AssemblyMetadata Include="ExtraVersion" Value="$(ProductExtraVersion)" />
		</ItemGroup>
	</Target>

</Project>
