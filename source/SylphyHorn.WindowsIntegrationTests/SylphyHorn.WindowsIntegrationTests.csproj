<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net10.0-windows10.0.26100.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);xUnit1069</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<MetroBinaryTfm Condition="'$(TargetFramework)' == 'net48'">net48</MetroBinaryTfm>
		<MetroBinaryTfm Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">net10.0-windows</MetroBinaryTfm>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="Xunit.StaFact" Version="4.0.23" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SylphyHorn.PlacementTestHost\SylphyHorn.PlacementTestHost.csproj"
		                  ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SylphyHorn\SylphyHorn.csproj">
			<AdditionalProperties>RunSylphyHornPostBuild=false</AdditionalProperties>
		</ProjectReference>
		<ProjectReference Include="..\SylphyHorn.SingleInstanceTestHost\SylphyHorn.SingleInstanceTestHost.csproj"
		                  ReferenceOutputAssembly="false"
		                  Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
			<AdditionalProperties>RunSylphyHornPostBuild=false</AdditionalProperties>
		</ProjectReference>
		<ProjectReference Include="..\SylphyHorn.VirtualDesktopInteropTestHost\SylphyHorn.VirtualDesktopInteropTestHost.csproj"
		                  ReferenceOutputAssembly="false"
		                  Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'" />
		<Reference Include="MetroTrilithon">
			<HintPath>..\libraries\MetroTrilithon.Desktop\$(MetroBinaryTfm)\MetroTrilithon.dll</HintPath>
		</Reference>
		<Reference Include="MetroTrilithon.Desktop">
			<HintPath>..\libraries\MetroTrilithon.Desktop\$(MetroBinaryTfm)\MetroTrilithon.Desktop.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="WritePlacementTestHostPath"
	        AfterTargets="Build">
		<MSBuild Projects="..\SylphyHorn.PlacementTestHost\SylphyHorn.PlacementTestHost.csproj"
		         Targets="GetAppHostPath"
		         Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)">
			<Output TaskParameter="TargetOutputs" ItemName="_PlacementTestHostTarget" />
		</MSBuild>
		<WriteLinesToFile File="$(TargetDir)PlacementTestHost.path"
		                  Lines="@(_PlacementTestHostTarget)"
		                  Overwrite="true"
		                  Encoding="UTF-8" />
	</Target>

	<Target Name="WriteSingleInstanceTestHostPath"
	        AfterTargets="Build"
	        Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
		<MSBuild Projects="..\SylphyHorn.SingleInstanceTestHost\SylphyHorn.SingleInstanceTestHost.csproj"
		         Targets="GetTargetPath"
		         Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework);RunSylphyHornPostBuild=false">
			<Output TaskParameter="TargetOutputs" ItemName="_SingleInstanceTestHostTarget" />
		</MSBuild>
		<WriteLinesToFile File="$(TargetDir)SingleInstanceTestHost.path"
		                  Lines="@(_SingleInstanceTestHostTarget)"
		                  Overwrite="true"
		                  Encoding="UTF-8" />
	</Target>

	<Target Name="WriteVirtualDesktopInteropTestHostPath"
	        AfterTargets="Build"
	        Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
		<MSBuild Projects="..\SylphyHorn.VirtualDesktopInteropTestHost\SylphyHorn.VirtualDesktopInteropTestHost.csproj"
		         Targets="GetAppHostPath"
		         Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)">
			<Output TaskParameter="TargetOutputs" ItemName="_VirtualDesktopInteropTestHostTarget" />
		</MSBuild>
		<WriteLinesToFile File="$(TargetDir)VirtualDesktopInteropTestHost.path"
		                  Lines="@(_VirtualDesktopInteropTestHostTarget)"
		                  Overwrite="true"
		                  Encoding="UTF-8" />
	</Target>

</Project>
