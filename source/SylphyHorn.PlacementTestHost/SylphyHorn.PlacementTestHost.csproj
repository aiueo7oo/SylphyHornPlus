<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net10.0-windows10.0.26100.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<Target Name="GetAppHostPath" DependsOnTargets="Build" Returns="@(_PlacementHostPath)">
		<ItemGroup>
			<_PlacementHostPath Include="$(TargetDir)$(TargetName).exe" />
		</ItemGroup>
	</Target>
</Project>
