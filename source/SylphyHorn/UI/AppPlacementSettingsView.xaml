<UserControl x:Class="SylphyHorn.UI.AppPlacementSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             IsVisibleChanged="OnVisibleChanged">
	<UserControl.Resources>
		<DataTemplate x:Key="PlacementDialogContent">
			<DockPanel>
				<DockPanel DockPanel.Dock="Top" metro:MetroWindow.IsCaptionBar="True">
					<Border DockPanel.Dock="Bottom" Height="8" />
					<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
					            HorizontalAlignment="Right" VerticalAlignment="Top"
					            WindowChrome.IsHitTestVisibleInChrome="True">
						<metro:SystemButtons />
					</StackPanel>
					<TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
					           FontFamily="Segoe UI Light, Meiryo UI" FontSize="18" Margin="12,8" />
				</DockPanel>
				<ContentPresenter Content="{Binding}" />
			</DockPanel>
		</DataTemplate>
		<BooleanToVisibilityConverter x:Key="Visible" />
		<Style x:Key="InlineMessage" TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,4" />
			<Style.Triggers>
				<Trigger Property="Text" Value="">
					<Setter Property="Visibility" Value="Collapsed" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="16,0,16,16" Focusable="True" Grid.IsSharedSizeScope="True">
			<TextBlock Text="{Binding Text[Title]}" Style="{DynamicResource HeaderStyleKey}" />
			<CheckBox Content="{Binding Text[Enable]}" IsChecked="{Binding IsEnabled}" Margin="8,0,0,8" />
			<CheckBox Content="{Binding Text[CreateMissing]}"
			          IsChecked="{Binding CreateMissingDesktops}"
			          IsEnabled="{Binding IsEnabled}"
			          Margin="8,0,0,8" />
			<CheckBox IsChecked="{Binding FollowForeground}" IsEnabled="{Binding IsEnabled}" Margin="8,0,0,8">
				<TextBlock Text="{Binding Text[FollowForeground]}" TextWrapping="Wrap" />
			</CheckBox>
			<ItemsControl ItemsSource="{Binding Groups}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="0,0,0,8">
							<TextBlock Text="{Binding Title}" Style="{DynamicResource HeaderStyleKey}" />
							<TextBlock Text="{Binding Description}"
							           Style="{StaticResource InlineMessage}"
							           Margin="8,0,0,8" />
							<Grid Margin="8,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="56" />
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementDelete" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="{Binding Owner.Text[EnabledColumn]}" />
								<TextBlock Grid.Column="1" Text="{Binding DestinationLabel}" />
								<TextBlock Grid.Column="3" Text="{Binding Owner.Text[AppColumn]}" />
							</Grid>
							<ItemsControl ItemsSource="{Binding Rows}" Margin="8,0,0,0">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,0,0,8" KeyboardNavigation.TabNavigation="Local" PreviewKeyDown="InputKey">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="56" />
												<ColumnDefinition Width="120" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementDelete" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
												<RowDefinition Height="Auto" />
											</Grid.RowDefinitions>
											<CheckBox KeyboardNavigation.TabIndex="0"
											          IsChecked="{Binding Enabled}"
											          Click="Commit"
											          VerticalAlignment="Center"
											          ToolTip="{Binding Group.Owner.Text[RuleEnabled]}"
											          AutomationProperties.Name="{Binding Group.Owner.Text[RuleEnabled]}" />
											<metro:PromptComboBox Prompt=""
											                      KeyboardNavigation.TabIndex="1"
											                      Grid.Column="1"
											                      IsEditable="True"
											                      IsTextSearchEnabled="False"
											                      ItemsSource="{Binding Group.Choices, Mode=OneTime}"
											                      Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
											                      VerticalAlignment="Center"
											                      LostKeyboardFocus="Commit"
											                      DropDownOpened="DestinationOpened"
											                      DropDownClosed="DestinationClosed"
											                      AutomationProperties.Name="{Binding Group.DestinationLabel}" />
											<DockPanel Grid.Column="3" VerticalAlignment="Center">
												<Button KeyboardNavigation.TabIndex="3"
												        DockPanel.Dock="Right"
												        Content="…"
												        Width="26"
												        Margin="4,0,0,0"
												        VerticalAlignment="Center"
												        Click="Pick"
												        ToolTip="{Binding Group.Owner.Text[ChooseApp]}"
												        AutomationProperties.Name="{Binding Group.Owner.Text[ChooseApp]}" />
												<Image Source="{Binding Icon}"
												       Width="16"
												       Height="16"
												       Margin="0,0,4,0"
												       VerticalAlignment="Center"
												       ToolTip="{Binding Name}">
													<Image.Style>
														<Style TargetType="Image">
															<Style.Triggers>
																<DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
																	<Setter Property="Visibility" Value="Hidden" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Image.Style>
												</Image>
												<metro:PromptTextBox Prompt=""
												                     KeyboardNavigation.TabIndex="2"
												                     Text="{Binding AppText, UpdateSourceTrigger=PropertyChanged}"
												                     IsReadOnly="{Binding IsPackage}"
												                     LostKeyboardFocus="Commit"
												                     VerticalAlignment="Center"
												                     ToolTip="{Binding AppText}"
												                     AutomationProperties.Name="{Binding Group.Owner.Text[PathColumn]}" />
											</DockPanel>
											<Button KeyboardNavigation.TabIndex="4"
											        Grid.Column="4"
											        Content="{Binding Group.Owner.Text[DeleteLabel]}"
											        Margin="6,0,0,0"
											        VerticalAlignment="Center"
											        Command="{Binding RemoveCommand}"
											        ToolTip="{Binding Group.Owner.Text[Delete]}"
											        AutomationProperties.Name="{Binding Group.Owner.Text[Delete]}" />
											<Button Grid.Row="1" Grid.Column="3" Content="{Binding FollowLabel}"
											        HorizontalAlignment="Left" Margin="0,4,0,0" Click="OpenFollowMenu"
											        KeyboardNavigation.TabIndex="5">
												<Button.ContextMenu>
													<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
														<MenuItem Header="{Binding Group.Owner.Text[FollowDefault]}" Tag="default"
														          IsCheckable="True" IsChecked="{Binding IsFollowDefault, Mode=OneWay}" Click="FollowSelected" />
														<MenuItem Header="{Binding Group.Owner.Text[FollowYes]}" Tag="true"
														          IsCheckable="True" IsChecked="{Binding IsFollowYes, Mode=OneWay}" Click="FollowSelected" />
														<MenuItem Header="{Binding Group.Owner.Text[FollowNo]}" Tag="false"
														          IsCheckable="True" IsChecked="{Binding IsFollowNo, Mode=OneWay}" Click="FollowSelected" />
													</ContextMenu>
												</Button.ContextMenu>
											</Button>
											<TextBlock Grid.Row="2"
											           Grid.Column="1"
											           Grid.ColumnSpan="3"
											           Text="{Binding Error}"
											           Style="{StaticResource InlineMessage}"
											           Foreground="{DynamicResource AccentBrushKey}"
											           AutomationProperties.LiveSetting="Polite" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Grid Margin="8,0,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="8" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Button Content="{Binding Owner.Text[AddManual]}" Click="Add" Margin="0" />
								<Button Grid.Column="2"
								        Content="{Binding Owner.Text[AddFromApp]}"
								        Click="Pick"
								        Margin="0" />
							</Grid>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Text="{Binding Text[InputHint]}"
			           TextWrapping="Wrap"
			           Foreground="{DynamicResource InactiveForegroundBrushKey}" />
			<Button Content="{Binding Text[OpenApply]}"
			        Click="OpenApply"
			        HorizontalAlignment="Left"
			        Margin="0,16,0,0"
			        Padding="12,4" />
			<TextBlock Text="{Binding Text[CloseTitle]}" Style="{DynamicResource HeaderStyleKey}" />
			<CheckBox Content="{Binding Text[CloseCreated]}" IsChecked="{Binding CloseCreatedDesktops}" Margin="8,0,0,8" />
			<TextBlock Text="{Binding Text[CloseHint]}" Style="{StaticResource InlineMessage}" Margin="8,0,0,8" />
			<ItemsControl ItemsSource="{Binding ClosingGroups}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="8,0,0,8">
							<TextBlock Text="{Binding Title}" Margin="0,0,0,4" />
							<ItemsControl ItemsSource="{Binding Rows}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<StackPanel Margin="0,0,0,8" PreviewKeyDown="ClosingInputKey">
											<DockPanel>
												<Button DockPanel.Dock="Right" Content="{Binding Group.Owner.Text[DeleteLabel]}"
												        ToolTip="{Binding Group.Owner.Text[Delete]}" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
												<metro:PromptComboBox Prompt="" IsEditable="True"
												                      Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
												                      DropDownOpened="ClosingDestinationOpened" DropDownClosed="ClosingDestinationClosed"
												                      LostKeyboardFocus="ClosingCommit" AutomationProperties.Name="{Binding Group.Title}" />
											</DockPanel>
											<TextBlock Text="{Binding Error}" Style="{StaticResource InlineMessage}" />
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Button Content="{Binding Owner.Text[AddManual]}" Click="AddClosing" Margin="0" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Text="{Binding Message}"
			           Style="{StaticResource InlineMessage}"
			           AutomationProperties.LiveSetting="Polite" />
			<Button Content="{Binding Text[RetrySave]}"
			        Command="{Binding RetrySaveCommand}"
			        HorizontalAlignment="Left"
			        Visibility="{Binding SaveFailed, Converter={StaticResource Visible}}" />
			<Button Content="{Binding Text[Restart]}"
			        Command="{Binding RestartCommand}"
			        HorizontalAlignment="Left"
			        Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
