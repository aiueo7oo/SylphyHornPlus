<UserControl x:Class="SylphyHorn.UI.AppPlacementSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:metro="http://schemes.grabacr.net/winfx/2014/controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             IsVisibleChanged="OnVisibleChanged">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SylphyHorn;component/UI/SettingsPageResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="PlacementDialogContent">
				<DockPanel>
					<DockPanel DockPanel.Dock="Top" metro:MetroWindow.IsCaptionBar="True">
						<Border DockPanel.Dock="Bottom" Height="8" />
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
						            HorizontalAlignment="Right" VerticalAlignment="Top"
						            WindowChrome.IsHitTestVisibleInChrome="True">
							<metro:SystemButtons />
						</StackPanel>
						<TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
						           FontFamily="Segoe UI Light, Meiryo UI" FontSize="18" Margin="12,8" />
					</DockPanel>
					<ContentPresenter Content="{Binding}" />
				</DockPanel>
			</DataTemplate>
			<!-- Shown in the path box when there is no confirmed application icon: a window outline, not a real app. -->
			<Geometry x:Key="EmptyAppGlyph">M1.5,2.5 H14.5 V13.5 H1.5 Z M1.5,5.5 H14.5</Geometry>
		</ResourceDictionary>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<!-- Text generated from the templates below does not receive the settings window's implicit TextBlock style;
		     set the page colour here so it does not inherit the selected tab item's accent foreground. -->
		<StackPanel Margin="16,0,16,16" Focusable="True" Grid.IsSharedSizeScope="True" TextElement.Foreground="{DynamicResource ForegroundBrushKey}">
			<TextBlock Text="{Binding Text[Title]}" Style="{DynamicResource HeaderStyleKey}" />
			<CheckBox Content="{Binding Text[Enable]}" IsChecked="{Binding IsEnabled}" Margin="8,0,0,8" />
			<CheckBox Content="{Binding Text[CreateMissing]}"
			          IsChecked="{Binding CreateMissingDesktops}"
			          IsEnabled="{Binding IsEnabled}"
			          Margin="8,0,0,8" />
			<StackPanel Orientation="Horizontal" Margin="8,8,0,0" IsEnabled="{Binding IsEnabled}">
				<TextBlock Text="{Binding Text[FollowForeground]}" Margin="0,0,12,0" VerticalAlignment="Center" />
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementFollow" />
					</Grid.ColumnDefinitions>
					<metro:PromptComboBox Prompt=""
					                      ItemsSource="{Binding DefaultFollowOptions}"
					                      DisplayMemberPath="Label"
					                      SelectedItem="{Binding DefaultFollowOption}"
					                      VerticalAlignment="Center"
					                      AutomationProperties.Name="{Binding Text[FollowForeground]}" />
				</Grid>
			</StackPanel>
			<TextBlock Text="{Binding Text[FollowHint]}" TextWrapping="Wrap" Margin="8,4,0,0" />
			<!-- Invisible width probes: every switch combo box shares the width of the longest label,
			     including "Default (Off)" while the global value is On, in the current language and font. -->
			<ItemsControl ItemsSource="{Binding FollowWidthSamples}"
			              Height="0"
			              Visibility="Hidden"
			              Focusable="False"
			              IsTabStop="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementFollow" />
							</Grid.ColumnDefinitions>
							<!-- One spare DIP: shared sizes are rounded per grid at fractional scales, and the visible
							     combo boxes must never end up narrower than the longest label. -->
							<metro:PromptComboBox Prompt=""
							                      Margin="0,0,1,0"
							                      ItemsSource="{Binding Alone}"
							                      DisplayMemberPath="Label"
							                      IsSynchronizedWithCurrentItem="True"
							                      Focusable="False"
							                      IsTabStop="False"
							                      IsHitTestVisible="False" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Style="{StaticResource Section}">
							<TextBlock Text="{Binding Title}" Style="{DynamicResource HeaderStyleKey}" />
							<TextBlock Text="{Binding Description}"
							           Style="{StaticResource InlineMessage}"
							           Margin="8,0,0,8" />
							<Border Style="{StaticResource EntryList}" Margin="8,0,0,0">
								<ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<!-- One entry: [Enabled] [label] [values] [actions]; the lower row leaves the Enabled
											     column empty and shares the label column, so both value fields start at one x. -->
											<Border BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,0,.99" Padding="0,8">
												<Grid KeyboardNavigation.TabNavigation="Local" PreviewKeyDown="InputKey">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementEnabled" />
														<ColumnDefinition Width="12" />
														<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementLabel" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition />
														<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementAction" />
													</Grid.ColumnDefinitions>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="4" />
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>
													<CheckBox KeyboardNavigation.TabIndex="0"
													          Content="{Binding Group.Owner.Text[EnabledColumn]}"
													          IsChecked="{Binding Enabled}"
													          Click="Commit"
													          VerticalAlignment="Center"
													          ToolTip="{Binding Group.Owner.Text[RuleEnabled]}"
													          AutomationProperties.Name="{Binding Group.Owner.Text[RuleEnabled]}" />
													<TextBlock Grid.Column="2" Text="{Binding Group.DestinationLabel}" VerticalAlignment="Center" />
													<Grid Grid.Column="4">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="110" />
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="Auto" SharedSizeGroup="PlacementFollow" />
															<ColumnDefinition />
														</Grid.ColumnDefinitions>
														<metro:PromptComboBox Prompt=""
														                      KeyboardNavigation.TabIndex="1"
														                      IsEditable="True"
														                      IsTextSearchEnabled="False"
														                      ItemsSource="{Binding Group.Choices, Mode=OneTime}"
														                      Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
														                      VerticalAlignment="Center"
														                      LostKeyboardFocus="Commit"
														                      DropDownOpened="DestinationOpened"
														                      DropDownClosed="DestinationClosed"
														                      AutomationProperties.Name="{Binding Group.DestinationLabel}" />
														<TextBlock Grid.Column="1" Text="{Binding Group.Owner.Text[FollowColumn]}" Margin="16,0,8,0" VerticalAlignment="Center" />
														<metro:PromptComboBox Grid.Column="2"
														                      Prompt=""
														                      KeyboardNavigation.TabIndex="2"
														                      ItemsSource="{Binding Group.Owner.FollowOptions}"
														                      DisplayMemberPath="Label"
														                      SelectedItem="{Binding FollowOption}"
														                      SelectionChanged="FollowChanged"
														                      VerticalAlignment="Center"
														                      AutomationProperties.Name="{Binding Group.Owner.Text[FollowColumn]}" />
													</Grid>
													<Button KeyboardNavigation.TabIndex="3"
													        Grid.Column="5"
													        Content="{Binding Group.Owner.Text[DeleteLabel]}"
													        Margin="8,0,0,0"
													        HorizontalAlignment="Right"
													        VerticalAlignment="Center"
													        Command="{Binding RemoveCommand}"
													        ToolTip="{Binding Group.Owner.Text[Delete]}"
													        AutomationProperties.Name="{Binding Group.Owner.Text[Delete]}" />
													<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Group.Owner.Text[AppColumn]}" VerticalAlignment="Center" />
													<DockPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center">
														<Button KeyboardNavigation.TabIndex="5"
														        DockPanel.Dock="Right"
														        Content="…"
														        Width="26"
														        Margin="4,0,0,0"
														        VerticalAlignment="Center"
														        Click="Pick"
														        ToolTip="{Binding Group.Owner.Text[ChooseApp]}"
														        AutomationProperties.Name="{Binding Group.Owner.Text[ChooseApp]}" />
														<Grid>
															<!-- The TextBox template applies Padding twice (content host margin and its
															     scroll viewer padding), so 12 starts the text about 6 right of the icon. -->
															<metro:PromptTextBox Prompt=""
															                     KeyboardNavigation.TabIndex="4"
															                     Padding="12,1,1,1"
															                     Text="{Binding AppText, UpdateSourceTrigger=PropertyChanged}"
															                     IsReadOnly="{Binding IsPackage}"
															                     LostKeyboardFocus="Commit"
															                     VerticalAlignment="Center"
															                     ToolTip="{Binding AppText}"
															                     AutomationProperties.Name="{Binding Group.Owner.Text[PathColumn]}" />
															<Image Source="{Binding Icon}"
															       Width="16"
															       Height="16"
															       Margin="5,0,0,0"
															       HorizontalAlignment="Left"
															       VerticalAlignment="Center"
															       IsHitTestVisible="False">
																<Image.Style>
																	<Style TargetType="Image">
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
																				<Setter Property="Visibility" Value="Collapsed" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Image.Style>
															</Image>
															<Path Data="{StaticResource EmptyAppGlyph}"
															      Stroke="{DynamicResource InactiveForegroundBrushKey}"
															      StrokeThickness="1"
															      Width="16"
															      Height="16"
															      Margin="5,0,0,0"
															      HorizontalAlignment="Left"
															      VerticalAlignment="Center"
															      SnapsToDevicePixels="True"
															      IsHitTestVisible="False">
																<Path.Style>
																	<Style TargetType="Path">
																		<Setter Property="Visibility" Value="Collapsed" />
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
																				<Setter Property="Visibility" Value="Visible" />
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Path.Style>
															</Path>
														</Grid>
													</DockPanel>
													<TextBlock Grid.Row="3"
													           Grid.Column="4"
													           Grid.ColumnSpan="2"
													           Text="{Binding Error}"
													           Style="{StaticResource InlineMessage}"
													           Foreground="{DynamicResource AccentBrushKey}"
													           AutomationProperties.LiveSetting="Polite" />
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
							<Grid Margin="8,12,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
									<ColumnDefinition Width="8" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Button Content="{Binding Owner.Text[AddManual]}" Click="Add" Margin="0" />
								<Button Grid.Column="2"
								        Content="{Binding Owner.Text[AddFromApp]}"
								        Click="Pick"
								        Margin="0" />
							</Grid>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<StackPanel Style="{StaticResource Section}">
				<TextBlock Text="{Binding Text[ApplyHeading]}" Style="{DynamicResource HeaderStyleKey}" />
				<TextBlock Text="{Binding Text[ApplyHint]}" TextWrapping="Wrap" Margin="8,0,0,12" />
				<Button Content="{Binding Text[OpenApply]}"
				        Click="OpenApply"
				        HorizontalAlignment="Left"
				        Margin="8,0,0,0"
				        Padding="12,4" />
			</StackPanel>
			<StackPanel Margin="8,8,0,0">
				<TextBlock Text="{Binding Message}"
				           Style="{StaticResource InlineMessage}"
				           AutomationProperties.LiveSetting="Polite" />
				<Button Content="{Binding Text[RetrySave]}"
				        Command="{Binding RetrySaveCommand}"
				        HorizontalAlignment="Left"
				        Visibility="{Binding SaveFailed, Converter={StaticResource Visible}}" />
				<Button Content="{Binding Text[Restart]}"
				        Command="{Binding RestartCommand}"
				        HorizontalAlignment="Left"
				        Visibility="{Binding IsPaused, Converter={StaticResource Visible}}" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
